#!/bin/zsh
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"

if [ -x "$repo_root/.tooling/flutter/bin/flutter" ]; then
  export PATH="$repo_root/.tooling/flutter/bin:$PATH"
  export HOME="$repo_root/.tooling/home"
  export PUB_CACHE="$repo_root/.tooling/pub-cache"
  export XDG_CONFIG_HOME="$repo_root/.tooling/config"
fi

exec flutter "$@"
